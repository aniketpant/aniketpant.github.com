---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Four-Oh-Four" slug="404">
  <div class="flex flex-col items-center justify-center mx-auto py-12">
    <div class="prose prose-slate text-center max-w-lg">
      <h1 class="text-4xl font-serif font-bold text-slate-900">404</h1>
      <p class="text-gray-600 my-4">Seems like I did something wrong.</p>
      <blockquote class="border-l-4 border-brand pl-4 my-6 italic text-gray-700">
        <p>
          The tree<br />
          Autumn it was<br />
          Leaves floating, flying around
        </p>
        <cite class="block mt-2 font-normal not-italic text-sm text-gray-500">
          &ndash; <a href="/2013/01/lights-and-sounds/" class="text-brand hover:underline font-semibold">Lights &amp; Sounds</a>
        </cite>
      </blockquote>
    </div>
  </div>
</BaseLayout>
