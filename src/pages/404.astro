---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Four-Oh-Four" slug="404">
  <div class="flex flex-col items-center justify-center py-24 md:py-32 text-center animate-fade-in">
    <div class="mb-8 relative">
      <span class="text-8xl md:text-[10rem] font-serif font-bold gradient-text select-none leading-[1.05]" aria-hidden="true">404</span>
      <div class="deco-blob bg-[var(--color-brand)] w-[200px] h-[200px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-[0.12]" aria-hidden="true"></div>
    </div>

    <h1 class="text-2xl md:text-3xl font-serif font-semibold text-[var(--fg)] mb-3">
      Page not found
    </h1>
    <p class="text-[var(--fg-muted)] mb-12 max-w-md">
      Seems like I did something wrong. The page you're looking for doesn't exist or has been moved.
    </p>

    <blockquote class="border-l-2 border-[var(--color-brand)] pl-6 py-1 my-6 italic text-[var(--fg-muted)] text-left max-w-md">
      <p class="font-serif text-lg leading-relaxed">
        The tree<br />
        Autumn it was<br />
        Leaves floating, flying around
      </p>
      <cite class="block mt-3 text-sm not-italic text-[var(--fg-subtle)]">
        &mdash; <a href="/2013/01/lights-and-sounds/" class="text-[var(--color-brand)] hover:underline underline-offset-4 font-medium">Lights &amp; Sounds</a>
      </cite>
    </blockquote>

    <a
      href="/"
      class="mt-10 inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[var(--color-brand)] text-white text-sm font-medium hover:bg-[var(--color-brand-hover)] transition-colors duration-200"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10" />
      </svg>
      Back home
    </a>
  </div>
</BaseLayout>
