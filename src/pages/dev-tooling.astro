---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ProjectIdeas from '../components/ProjectIdeas.astro';
import MermaidFigure from '../components/MermaidFigure.astro';
import CapabilityTable from '../components/CapabilityTable.astro';
import PaletteStrip from '../components/PaletteStrip.astro';

// One page for the three repositories that rebuild this machine.
//
// Editorial rule for this page: every section states the intent behind the
// repository and what it does now. A constraint earns a place only where it
// explains a decision that is already visible in the result. No numbers
// without a machine, a command and a run.

interface Tool {
  id: string;
  intent: string;
  now: string;
  figure: 'table' | 'flow';
  label: string;
  caption?: string;
  table?: {
    surface: string;
    first: string;
    second: string;
    degraded?: boolean;
  }[];
  wide?: string;
  narrow?: string;
  palette?: boolean;
  paletteCaption?: string;
  ideas: { title: string; text: string }[];
}

const tools: Tool[] = [
  {
    id: 'botfiles',
    intent:
      'Agent tooling should not belong to one harness. Every harness has its own plugin API, and configuration written against one of them is lost when the next one arrives.',
    now: 'Extensions, skills, prompts and themes are written once and mount in both pi and OpenCode V2. Where the two harnesses are not equivalent, the capability table records it, so a gap is a documented no-op instead of a fork.',
    figure: 'table',
    table: [
      {
        surface: 'ctx.ui',
        first: 'status bar, notify',
        second: 'absent, no-ops',
        degraded: true,
      },
      { surface: 'flags', first: 'pi.getFlag', second: 'BOTFILES_* env' },
      {
        surface: 'transcripts',
        first: 'filesystem walk',
        second: 'observed sessions',
      },
    ],
    label: 'botfiles: where the two harnesses are not equivalent',
    caption:
      'Three surfaces cannot be shared, so they degrade instead of forking the extension: a missing one becomes a no-op, an env fallback, or a smaller set of sessions.',
    ideas: [
      {
        title: 'The adapter absorbs the difference',
        text: 'pi runs one extension per session; OpenCode loads one plugin and calls the factory per session, keeping a map from session to instance. Tools and commands register once and carry their own session id, so the extension code never learns which harness it is in.',
      },
      {
        title: 'Skills move with their extension',
        text: 'Skills every session needs live in skills/. A skill that only applies to one extension lives in that extension\u2019s folder, so installing or removing the extension moves the skill with it instead of leaving a dead entry behind.',
      },
    ],
  },
  {
    id: 'droidfiles',
    intent:
      'A phone should be rebuildable from a bare Termux, not remembered. Every change that matters lives in the repository, so a reinstall is a command and not an afternoon.',
    now: 'bootstrap.sh installs the package list and calls install.sh, which relinks the dotfiles; both also run alone. Shell tests run in a temporary home, so a restore is checked before it touches mine.',
    figure: 'flow',
    wide: `flowchart LR
  I["install.sh"] --> Q{"real file differs?"}
  Q -->|yes| D["~/.droidfiles-backup/"]
  Q -->|no| H["$HOME"]`,
    narrow: `flowchart TB
  I["install.sh"] --> Q{"real file differs?"}
  Q -->|yes| D["~/.droidfiles-backup/"]
  Q -->|no| H["$HOME"]`,
    label: 'droidfiles: what install.sh does with an existing file',
    caption:
      'A symlink, or a file that already matches the repository copy, is replaced with no backup. Only a real file that differs is kept.',
    ideas: [
      {
        title: 'Symlinks, except where Android refuses them',
        text: 'Termux:Widget and Termux:Boot resolve symlinks and refuse a script whose real path is outside their folders. Executables stay in home/bin, and install.sh writes the two wrappers as real files instead of links.',
      },
      {
        title: 'A hand-kept package list',
        text: 'pkg has no installed-on-purpose flag, so packages.txt is maintained by hand and lists what I chose to install, never dependencies. An upgrade that pulls something in does not enter the file, so a restore brings back the system I asked for, not the last one.',
      },
    ],
  },
  {
    id: 'dotfiles',
    intent:
      'Muscle memory should move between machines: the same shell, terminal and key map wherever I sit down.',
    now: 'One palette across the shell and the TUI, a Cmd layer on Linux with per-app masks, and stow folders that mirror their home paths, so a new machine takes the same make install.',
    figure: 'flow',
    palette: true,
    paletteCaption:
      'Ghostty, pi and opencode read one theme, so a colour means the same thing in the terminal, the prompt and the agent.',
    wide: `flowchart LR
  R["zsh/ ghostty/ keyd/"] --> M["make install"]
  M --> H["$HOME"]`,
    narrow: `flowchart TB
  R["zsh/ ghostty/ keyd/"] --> M["make install"]
  M --> H["$HOME"]`,
    label: 'dotfiles: stow folders into home',
    caption:
      'Each folder mirrors its path in the home directory, so stow resolves the target without a mapping file. make clean is a separate target that unstows them.',
    ideas: [
      {
        title: 'Cmd on Linux, and what breaks',
        text: 'A keyd layer maps Cmd to Ctrl globally, with a per-app mask so the terminal keeps its own shortcuts. Redefining Super replaces GNOME\u2019s chords, and the README lists the bindings that do not fire rather than pretending the layer is complete.',
      },
      {
        title: 'Deferred until first use',
        text: 'Plugins load through zinit in turbo mode and are deferred until first use. A plugin that cannot be deferred is removed rather than paid for in every shell.',
      },
    ],
  },
];
---

<BaseLayout
  title="Dev tooling"
  slug="dev-tooling"
  description="botfiles, droidfiles and dotfiles: the three repositories that rebuild my machine, with the intent behind each and what it does now."
>
  <div class="animate-fade-in">
    <header class="relative pt-16 md:pt-24 pb-10 md:pb-12 overflow-hidden">
      <div
        class="deco-blob bg-[var(--color-brand)] w-[400px] h-[400px] -top-32 -right-32 opacity-[0.08]"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto max-w-3xl px-6 md:px-8 relative">
        <p
          class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--fg-subtle)]"
        >
          <span class="text-[var(--color-brand)]">aniketpant</span> / tooling
        </p>

        <h1
          class="mt-2.5 font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.04] tracking-tight gradient-text"
        >
          Dev tooling
        </h1>

        <p class="mt-3.5 text-lg text-[var(--fg-muted)] max-w-[52ch]">
          The agent, the phone and the shell, each built so it outlasts the
          thing it runs on.
        </p>

        <div class="gradient-line mt-6 w-20" aria-hidden="true"></div>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-6 md:px-8 pb-16 md:pb-24">
      {
        tools.map((tool, index) => (
          <section id={tool.id} class="scroll-mt-24">
            <ProjectSection
              n={String(index + 1).padStart(2, '0')}
              title={tool.id}
            />

            <dl class="mt-3 mb-0 border-t border-[var(--border)]">
              <div class="flex flex-col sm:flex-row gap-1 sm:gap-4 py-2.5 border-b border-[var(--border)]">
                <dt class="eyebrow sm:basis-14 shrink-0 pt-1 m-0">Intent</dt>
                <dd class="m-0 text-[15px] text-[var(--fg)]">{tool.intent}</dd>
              </div>
              <div class="flex flex-col sm:flex-row gap-1 sm:gap-4 py-2.5 border-b border-[var(--border)]">
                <dt class="eyebrow sm:basis-14 shrink-0 pt-1 m-0">Now</dt>
                <dd class="m-0 text-[15px] text-[var(--fg-muted)]">
                  {tool.now}
                </dd>
              </div>
            </dl>

            {tool.figure === 'table' ? (
              <CapabilityTable
                firstLabel="pi"
                secondLabel="opencode v2"
                rows={tool.table ?? []}
                label={tool.label}
                caption={tool.caption}
              />
            ) : (
              <>
                {tool.palette && <PaletteStrip caption={tool.paletteCaption} />}
                <MermaidFigure
                  label={tool.label}
                  source={tool.wide ?? ''}
                  narrowSource={tool.narrow}
                  caption={tool.caption}
                />
              </>
            )}

            <ProjectIdeas items={tool.ideas} />
          </section>
        ))
      }

      <p
        class="mt-9 pt-4 border-t border-[var(--border)] text-[12.5px] text-[var(--fg-subtle)]"
      >
        The repositories are private; each section is its public summary.
      </p>
    </div>
  </div>
</BaseLayout>
