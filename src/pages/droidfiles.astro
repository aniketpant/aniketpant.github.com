---
import ProjectPage from '../components/ProjectPage.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ProjectRows from '../components/ProjectRows.astro';
import ProjectIdeas from '../components/ProjectIdeas.astro';

const chips = [
  { label: 'private', hot: true },
  { label: 'android' },
  { label: 'shell' },
  { label: 'termux' },
];

const spec = [
  { k: 'Role', v: 'Machine setup', note: 'for this phone' },
  { k: 'Runs on', v: 'Termux on Android' },
  { k: 'Built with', v: 'Bash, with shell tests' },
];

const rows = [
  { path: 'packages.txt', text: 'Packages installed on purpose; dependencies are left out' },
  { path: 'bootstrap.sh', text: 'Updates package lists, installs packages.txt, runs install.sh' },
  { path: 'install.sh', text: 'Links home/* into $HOME, after a backup' },
  { path: 'home/.bashrc', text: 'History, aliases, EDITOR, node heap size' },
  { path: 'home/bin/', text: 'Executables, including the Pi Pocket supervisor' },
  { path: 'pi-pocket/extensions/', text: 'Wake lock, classifier, spec gate, research' },
  { path: 'test/run.sh', text: 'Shell tests, run in a temporary home directory' },
];

const ideas = [
  {
    title: 'Restore in one run',
    text: 'bootstrap.sh installs the packages from packages.txt, then install.sh links the dotfiles back into place. A Termux reinstall takes minutes.',
  },
  {
    title: 'Backup before replacing',
    text: 'A real file that differs from the repository copy is moved to ~/.droidfiles-backup/ under a timestamp before it is replaced. An existing symlink, or a file that already matches, is replaced with no backup.',
  },
  {
    title: 'Symlinks, except where Android refuses them',
    text: 'Termux:Widget and Termux:Boot resolve symlinks and refuse a script whose real path is outside their folders. Executables stay in home/bin, and install.sh writes the two wrappers as real files.',
  },
  {
    title: 'Hand-kept package list',
    text: 'pkg has no installed-on-purpose flag, so packages.txt is maintained by hand. It lists what I chose to install, never dependencies.',
  },
];
---

<ProjectPage
  title="droidfiles"
  repo="droidfiles"
  lede="My Termux setup on Android, rebuilt by one script."
  description="My Termux setup on Android: the packages I install on purpose and the dotfiles I care about, restored by one script."
  chips={chips}
  spec={spec}
>
  <ProjectSection n="01" title="Background">
    <p class="mt-2 text-[15px] text-[var(--fg-muted)]">
      This phone is my main machine. A Termux reinstall used to mean remembering which packages,
      aliases and settings I had added.
    </p>
    <p class="mt-3 text-[15px] text-[var(--fg-muted)]">
      This repository is that list: the packages I install on purpose, the dotfiles I want back, and
      the Pi Pocket drop-ins. The agent configuration is in <a
        href="/botfiles/"
        class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors"
        >botfiles</a
      >.
    </p>
  </ProjectSection>

  <ProjectSection n="02" title="Shape">
    <ProjectRows items={rows} />
  </ProjectSection>

  <ProjectSection n="03" title="Design ideas">
    <ProjectIdeas items={ideas} />
  </ProjectSection>

  <p slot="note">
    The repository is private; this page is its public summary. Skills, prompts and adapters are in{' '}
    <a
      href="/botfiles/"
      class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors"
      >botfiles</a
    >. No secrets are in this repository.
  </p>
</ProjectPage>
