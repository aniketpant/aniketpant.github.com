---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { processPost, sortPostsDesc } from '../utils/posts';

const rawPosts = await getCollection('posts');
const processed = rawPosts.map(processPost);
const sortedPosts = sortPostsDesc(processed.filter((p) => p.category !== 'talk'));

const firstFive = sortedPosts.slice(0, 5);
const nextFive = sortedPosts.slice(5, 10);
---

<BaseLayout title="Aniket Pant" slug="home" isHome={true}>
  <div class="py-16 md:py-24 animate-fade-in">
    <!-- Hero -->
    <section class="text-center mb-16 md:mb-20">
      <p class="font-serif text-2xl md:text-3xl lg:text-4xl leading-relaxed text-[var(--fg)] max-w-2xl mx-auto">
        Hello! I'm <a class="text-[var(--color-brand)] no-underline font-normal hover:underline underline-offset-4" href="/about/" rel="nofollow">Aniket</a> and I love to <em>read</em>, <em>write</em> and <em>code</em>.
      </p>
    </section>

    <!-- Recent posts -->
    <section aria-label="Recent writing">
      <ul class="space-y-8 md:space-y-10 stagger-children">
        {firstFive.map((post) => (
          <li class="animate-fade-in-up">
            <article>
              <a href={post.url} class="group block">
                <div class="flex items-baseline gap-3 mb-1.5">
                  <time datetime={post.isoDate} class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-24 md:w-28">
                    {post.relativeTime}
                  </time>
                  <h2 class="text-lg md:text-xl font-serif font-semibold text-[var(--fg)] group-hover:text-[var(--color-brand)] transition-colors duration-200 leading-snug">
                    {post.title}
                  </h2>
                </div>
                {post.excerpt && (
                  <p class="text-[var(--fg-muted)] text-sm md:text-base leading-relaxed ml-24 md:ml-28 line-clamp-2">
                    {post.excerpt}
                  </p>
                )}
              </a>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <!-- Older posts (titles only) -->
    {nextFive.length > 0 && (
      <section class="mt-12 md:mt-16" aria-label="Older writing">
        <h2 class="text-sm font-medium uppercase tracking-wider text-[var(--fg-subtle)] mb-6">Earlier</h2>
        <ul class="space-y-4 stagger-children">
          {nextFive.map((post) => (
            <li class="animate-fade-in-up">
              <a href={post.url} class="group flex items-baseline gap-3">
                <time datetime={post.isoDate} class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-24 md:w-28">
                  {post.relativeTime}
                </time>
                <span class="text-[var(--fg-muted)] group-hover:text-[var(--color-brand)] transition-colors duration-200">
                  {post.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- View all -->
    <div class="mt-12 md:mt-16 text-center">
      <a
        href="/archive/"
        class="inline-flex items-center gap-2 text-sm font-medium text-[var(--fg-muted)] hover:text-[var(--color-brand)] transition-colors duration-200"
      >
        View all posts
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
