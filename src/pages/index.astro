---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DitherBackdrop from '../components/DitherBackdrop.astro';
import { processPost, sortPostsDesc } from '../utils/posts';
import { featuredProjects } from '../data/projects';
import ReadingList from '../components/ReadingList.astro';

const rawPosts = await getCollection('posts');
const processed = rawPosts.map(processPost);
const sortedPosts = sortPostsDesc(
  processed.filter((p) => p.category !== 'talk'),
);

const firstFive = sortedPosts.slice(0, 5);
const nextFive = sortedPosts.slice(5, 10);
---

<BaseLayout title="Aniket Pant" slug="home" isHome={true}>
  <div class="relative overflow-hidden">
    <!-- Dithered backdrop — soft theme-tint wash, bounded to the hero -->
    <div
      class="absolute inset-x-0 top-0 z-0 h-[540px] md:h-[640px]"
      aria-hidden="true"
    >
      <DitherBackdrop />
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 md:px-8">
      <!-- Hero -->
      <section class="pt-20 md:pt-32 pb-16 md:pb-24 animate-fade-in">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
          <!-- Left: large display type -->
          <div class="md:col-span-7">
            <p class="eyebrow mb-6">Personal weblog</p>
            <h1
              class="hero-weight font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.0] md:leading-[0.95] tracking-tight"
            >
              Hello.<br />
              I'm <span class="gradient-text-subtle italic">Aniket</span>
            </h1>
          </div>
          <!-- Right: intro text -->
          <div class="md:col-span-5 md:pb-2">
            <p
              class="text-lg md:text-xl text-[var(--fg-muted)] leading-relaxed"
            >
              I love to <em class="text-[var(--fg)] italic">read</em>,{' '}
              <em class="text-[var(--fg)] italic">write</em> and{' '}
              <em class="text-[var(--fg)] italic">code</em>.
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
              <a
                href="/about/"
                data-hero-link
                class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-brand)] hover:text-[var(--color-brand-hover)] transition-colors group"
              >
                About me
                <svg
                  class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
              <a
                href="/archive/"
                data-hero-link
                class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-secondary)] hover:text-[var(--color-secondary-hover)] transition-colors group"
              >
                All posts
                <svg
                  class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Recent posts — clean aligned list -->
      <section aria-label="Recent writing" class="pb-16 md:pb-24">
        <div class="flex items-baseline gap-4 mb-10">
          <h2 class="eyebrow">Latest</h2>
          <div class="flex-1 h-px bg-[var(--border)]"></div>
        </div>

        <ul class="space-y-0 stagger-children">
          {
            firstFive.map((post) => (
              <li class="animate-fade-in-up border-t border-[var(--border)] first:border-t-0">
                <article>
                  <a href={post.url} class="group block py-6 md:py-8">
                    <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6">
                      <time
                        datetime={post.isoDate}
                        class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-28 font-medium"
                      >
                        {post.relativeTime}
                      </time>
                      <div class="flex-1 min-w-0">
                        <h3 class="text-xl md:text-2xl font-serif font-semibold text-[var(--fg)] group-hover:text-[var(--color-secondary)] transition-colors duration-200 leading-snug">
                          {post.title}
                        </h3>
                        {post.excerpt && (
                          <p class="text-[var(--fg-muted)] text-sm md:text-base mt-2 line-clamp-2 max-w-xl leading-relaxed">
                            {post.excerpt}
                          </p>
                        )}
                      </div>
                      <svg
                        class="w-5 h-5 text-[var(--fg-subtle)] group-hover:text-[var(--color-secondary)] group-hover:translate-x-1 transition-all duration-200 shrink-0 hidden md:block self-center"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </div>
                  </a>
                </article>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Earlier posts -->
      {
        nextFive.length > 0 && (
          <section class="pb-16 md:pb-24" aria-label="Older writing">
            <div class="flex items-baseline gap-4 mb-8">
              <h2 class="eyebrow">Earlier</h2>
              <div class="flex-1 h-px bg-[var(--border)]" />
            </div>

            <ul class="space-y-0 stagger-children">
              {nextFive.map((post) => (
                <li class="animate-fade-in-up border-t border-[var(--border-subtle)] first:border-t-0">
                  <a
                    href={post.url}
                    class="group flex items-baseline gap-4 md:gap-6 py-4 md:py-5"
                  >
                    <time
                      datetime={post.isoDate}
                      class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-28"
                    >
                      {post.relativeTime}
                    </time>
                    <span class="text-[var(--fg-muted)] group-hover:text-[var(--color-tertiary)] transition-colors duration-200 font-medium">
                      {post.title}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <ReadingList />

      <!-- Tooling — one page for the three repositories -->
      <section aria-label="Tooling" class="pb-16 md:pb-24">
        <div class="flex items-baseline gap-4 mb-6">
          <h2 class="eyebrow">Tooling</h2>
          <div class="flex-1 h-px bg-[var(--border)]"></div>
        </div>

        <div class="grid grid-cols-1 gap-3">
          {
            featuredProjects.map((project) => (
              <article class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 md:p-7 transition-colors duration-200 hover:border-[var(--color-brand)]">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3 class="m-0 font-serif text-[22px] md:text-[26px] font-semibold tracking-tight">
                    <a
                      href={project.href}
                      class="text-[var(--fg)] hover:text-[var(--color-brand)] transition-colors duration-200"
                    >
                      {project.name}
                    </a>
                  </h3>
                  <p class="eyebrow m-0">
                    {project.entries.length} repositories
                  </p>
                </div>

                <p class="mt-2.5 mb-0 max-w-[64ch] text-[13.5px] md:text-sm leading-relaxed text-[var(--fg-muted)]">
                  {project.blurb}
                </p>

                <ul class="mt-5 mb-0 list-none p-0 border-t border-[var(--border)]">
                  {project.entries.map((entry) => (
                    <li class="m-0 border-b border-[var(--border-subtle)] last:border-b-0">
                      <a
                        href={entry.href}
                        class="group/row grid grid-cols-1 sm:grid-cols-[150px_1fr] gap-x-4 gap-y-0.5 items-baseline py-2.5"
                      >
                        <span class="font-mono text-[13px] font-medium text-[var(--fg)] group-hover/row:text-[var(--color-brand)] transition-colors duration-200">
                          {entry.name}
                        </span>
                        <span class="text-[13px] text-[var(--fg-muted)]">
                          {entry.blurb}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
