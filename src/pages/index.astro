---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DitherBackdrop from '../components/DitherBackdrop.astro';
import { processPost, sortPostsDesc } from '../utils/posts';

const rawPosts = await getCollection('posts');
const processed = rawPosts.map(processPost);
const sortedPosts = sortPostsDesc(processed.filter((p) => p.category !== 'talk'));

const firstFive = sortedPosts.slice(0, 5);
const nextFive = sortedPosts.slice(5, 10);
---

<BaseLayout title="Aniket Pant" slug="home" isHome={true}>
  <div class="relative overflow-hidden">
    <!-- Dithered backdrop — soft theme-tint wash, bounded to the hero -->
    <div class="absolute inset-x-0 top-0 z-0 h-[540px] md:h-[640px]" aria-hidden="true">
      <DitherBackdrop />
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 md:px-8">
      <!-- Hero -->
      <section class="pt-20 md:pt-32 pb-16 md:pb-24 animate-fade-in">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
          <!-- Left: large display type -->
          <div class="md:col-span-7">
            <p class="text-sm font-medium uppercase tracking-widest text-[var(--fg-subtle)] mb-6">
              Personal weblog
            </p>
            <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.0] md:leading-[0.95] tracking-tight">
              Hello.<br />
              I'm <span class="gradient-text-subtle">Aniket</span>
            </h1>
          </div>
          <!-- Right: intro text -->
          <div class="md:col-span-5 md:pb-2">
            <p class="text-lg md:text-xl text-[var(--fg-muted)] leading-relaxed">
              I love to <em class="text-[var(--fg)] not-italic font-medium">read</em>,{' '}
              <em class="text-[var(--fg)] not-italic font-medium">write</em> and{' '}
              <em class="text-[var(--fg)] not-italic font-medium">code</em>.
            </p>
            <div class="mt-6 flex items-center gap-4">
              <a href="/about/" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-brand)] hover:text-[var(--color-brand-hover)] transition-colors group">
                About me
                <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
              <a href="/archive/" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-secondary)] hover:text-[var(--color-secondary-hover)] transition-colors group">
                All posts
                <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Recent posts — clean aligned list -->
      <section aria-label="Recent writing" class="pb-16 md:pb-24">
        <div class="flex items-baseline gap-4 mb-10">
          <h2 class="text-sm font-medium uppercase tracking-widest text-[var(--fg-subtle)]">Latest</h2>
          <div class="flex-1 h-px bg-[var(--border)]"></div>
        </div>

        <ul class="space-y-0 stagger-children">
          {firstFive.map((post) => (
            <li class="animate-fade-in-up border-t border-[var(--border)] first:border-t-0">
              <article>
                <a href={post.url} class="group block py-6 md:py-8">
                  <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6">
                    <time datetime={post.isoDate} class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-28 font-medium">
                      {post.relativeTime}
                    </time>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-xl md:text-2xl font-serif font-semibold text-[var(--fg)] group-hover:text-[var(--color-secondary)] transition-colors duration-200 leading-snug">
                        {post.title}
                      </h3>
                      {post.excerpt && (
                        <p class="text-[var(--fg-muted)] text-sm md:text-base mt-2 line-clamp-2 max-w-xl leading-relaxed">
                          {post.excerpt}
                        </p>
                      )}
                    </div>
                    <svg class="w-5 h-5 text-[var(--fg-subtle)] group-hover:text-[var(--color-secondary)] group-hover:translate-x-1 transition-all duration-200 shrink-0 hidden md:block self-center" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </div>
                </a>
              </article>
            </li>
          ))}
        </ul>
      </section>

      <!-- Earlier posts -->
      {nextFive.length > 0 && (
        <section class="pb-16 md:pb-24" aria-label="Older writing">
          <div class="flex items-baseline gap-4 mb-8">
            <h2 class="text-sm font-medium uppercase tracking-widest text-[var(--fg-subtle)]">Earlier</h2>
            <div class="flex-1 h-px bg-[var(--border)]"></div>
          </div>

          <ul class="space-y-0 stagger-children">
            {nextFive.map((post) => (
              <li class="animate-fade-in-up border-t border-[var(--border-subtle)] first:border-t-0">
                <a href={post.url} class="group flex items-baseline gap-4 md:gap-6 py-4 md:py-5">
                  <time datetime={post.isoDate} class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-28">
                    {post.relativeTime}
                  </time>
                  <span class="text-[var(--fg-muted)] group-hover:text-[var(--color-tertiary)] transition-colors duration-200 font-medium">
                    {post.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
