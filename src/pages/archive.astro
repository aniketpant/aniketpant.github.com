---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { processPost, sortPostsDesc } from '../utils/posts';

const rawPosts = await getCollection('posts');
const processed = rawPosts.map(processPost);
const archivePosts = sortPostsDesc(processed.filter((p) => p.category !== 'talk'));

// Group by year
const byYear = new Map<string, typeof archivePosts>();
for (const post of archivePosts) {
  const year = post.year;
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = Array.from(byYear.keys()).sort((a, b) => Number(b) - Number(a));
---

<PageLayout title="The preserved archives" slug="archive">
  <div class="space-y-12 md:space-y-16 stagger-children">
    {years.map((year) => (
      <section class="animate-fade-in-up">
        <div class="sticky top-14 bg-[var(--bg)]/80 backdrop-blur-md py-2 -mx-6 px-6 md:-mx-8 md:px-8 mb-6">
          <h2 class="text-sm font-medium uppercase tracking-wider gradient-text-subtle">
            {year}
          </h2>
          <div class="gradient-line mt-2 opacity-60" aria-hidden="true"></div>
        </div>
        <ul class="space-y-4">
          {byYear.get(year)!.map((post) => (
            <li>
              <a href={post.url} class="group flex items-baseline gap-4">
                <time datetime={post.isoDate} class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-24 md:w-32">
                  {post.formattedDate}
                </time>
                <span class="text-[var(--fg)] group-hover:text-[var(--color-brand)] transition-colors duration-200">
                  {post.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
