---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { processPost, sortPostsDesc } from '../utils/posts';

const rawPosts = await getCollection('posts');
const processed = rawPosts.map(processPost);
const talkPosts = sortPostsDesc(processed.filter((p) => p.category === 'talk'));
---

<PageLayout title="Speaking Engagements" slug="speaking">
  <div class="space-y-8 md:space-y-10 stagger-children">
    {talkPosts.map((post) => (
      <article class="animate-fade-in-up">
        <a href={post.url} class="group block">
          <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-4">
            <time datetime={post.isoDate} class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-32">
              {post.formattedDate}
            </time>
            <div>
              <h2 class="text-lg font-serif font-semibold text-[var(--fg)] group-hover:text-[var(--color-brand)] transition-colors duration-200 leading-snug">
                {post.title}
              </h2>
              {post.entry.data.event && (
                <p class="text-sm text-[var(--fg-muted)] mt-0.5">{post.entry.data.event}</p>
              )}
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>

  <div class="mt-12 md:mt-16 pt-8 border-t border-[var(--border)]">
    <p class="text-[var(--fg-muted)]">
      Take a look at the{' '}
      <a href="https://speakerdeck.com/aniketpant" class="text-[var(--color-brand)] hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">slides</a>{' '}
      or see the{' '}
      <a href="https://github.com/aniketpant/presentations" class="text-[var(--color-brand)] hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">code</a>.
    </p>
  </div>
</PageLayout>
