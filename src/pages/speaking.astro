---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { processPost, sortPostsDesc } from '../utils/posts';

const rawPosts = await getCollection('posts');
const processed = rawPosts.map(processPost);
const talkPosts = sortPostsDesc(processed.filter((p) => p.category === 'talk'));
---

<BaseLayout title="Speaking Engagements" slug="speaking">
  <div class="animate-fade-in">
    <header class="relative pt-16 md:pt-24 pb-12 md:pb-16 overflow-hidden">
      <div class="deco-blob bg-[var(--color-tertiary)] w-[400px] h-[400px] -top-32 -right-32 opacity-[0.08]" aria-hidden="true"></div>

      <div class="mx-auto max-w-5xl px-6 md:px-8 relative">
        <div class="max-w-3xl">
          <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] md:leading-[1.05] tracking-tight gradient-text">
            Speaking Engagements
          </h1>
          <p class="mt-4 text-lg text-[var(--fg-muted)]">
            Talks, workshops, and community events
          </p>
          <div class="gradient-line mt-6 w-20" aria-hidden="true"></div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-6 md:px-8 pb-16 md:pb-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="hidden md:block md:col-span-1">
          <div class="gradient-line-vertical h-24 sticky top-24 mx-auto" aria-hidden="true"></div>
        </div>
        <div class="md:col-span-11">
          <div class="space-y-8 md:space-y-10 stagger-children">
            {talkPosts.map((post) => (
              <article class="animate-fade-in-up">
                <a href={post.url} class="group block py-6 border-t border-[var(--border)]">
                  <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6">
                    <time datetime={post.isoDate} class="text-sm text-[var(--fg-subtle)] tabular-nums shrink-0 w-32 font-medium">
                      {post.formattedDate}
                    </time>
                    <div class="flex-1">
                      <h2 class="text-xl md:text-2xl font-serif font-semibold text-[var(--fg)] group-hover:text-[var(--color-tertiary)] transition-colors duration-200 leading-snug">
                        {post.title}
                      </h2>
                      {post.entry.data.event && (
                        <p class="text-sm text-[var(--fg-muted)] mt-1">{post.entry.data.event}</p>
                      )}
                    </div>
                    <svg class="w-5 h-5 text-[var(--fg-subtle)] group-hover:text-[var(--color-tertiary)] group-hover:translate-x-1 transition-all duration-200 shrink-0 hidden md:block self-center" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </div>
                </a>
              </article>
            ))}
          </div>

          <div class="mt-14 pt-8 border-t border-[var(--border)]">
            <p class="text-[var(--fg-muted)]">
              Take a look at the{' '}
              <a href="https://speakerdeck.com/aniketpant" class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors" target="_blank" rel="noopener noreferrer">slides</a>{' '}
              or see the{' '}
              <a href="https://github.com/aniketpant/presentations" class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors" target="_blank" rel="noopener noreferrer">code</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
