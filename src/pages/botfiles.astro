---
import ProjectPage from '../components/ProjectPage.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ProjectRows from '../components/ProjectRows.astro';
import ProjectIdeas from '../components/ProjectIdeas.astro';

const chips = [
  { label: 'private', hot: true },
  { label: 'bun' },
  { label: 'pi package' },
  { label: 'OpenCode V2 adapters' },
];

const spec = [
  { k: 'Role', v: 'Agent configuration', note: 'loaded by every session' },
  { k: 'Runs in', v: 'pi and OpenCode V2' },
  { k: 'Built with', v: 'TypeScript and bun workspaces' },
];

const rows = [
  { path: 'packages/', text: 'Shared logic as bun workspaces, each with tests' },
  { path: 'extensions/', text: 'Tools, commands and hooks, defined once' },
  { path: 'adapters/', text: 'The harness edge: pi, OpenCode, lane' },
  { path: 'skills/', text: 'Agent Skills for every session' },
  { path: 'prompts/', text: 'Prompt templates, available as /name' },
  { path: 'themes/', text: 'TUI themes' },
];

const ideas = [
  {
    title: 'One definition per feature',
    text: 'An extension describes its behaviour without naming a harness. Adding a second harness takes one adapter, not a second copy of the feature.',
  },
  {
    title: 'The adapter holds the difference',
    text: 'pi runs one extension instance per session. OpenCode loads one plugin that serves many sessions. The adapter keeps a map from session to instance, so the extension code does not handle it.',
  },
  {
    title: 'Skills sit with what uses them',
    text: 'Skills used by every session are in skills/. A skill that only applies to one extension lives in that extension\u2019s folder, so installing or removing the extension moves the skill too.',
  },
  {
    title: 'Small entries, cheap reloads',
    text: 'The pi entry of an extension is one line that mounts the factory. /reload after an edit stays fast.',
  },
];
---

<ProjectPage
  title="botfiles"
  repo="botfiles"
  lede="Agent configuration for pi and OpenCode V2."
  description="My agent configuration as a pi package: extensions, skills, prompt templates, and themes, with adapters for OpenCode V2."
  chips={chips}
  spec={spec}
>
  <ProjectSection n="01" title="Background">
    <p class="mt-2 text-[15px] text-[var(--fg-muted)]">
      The configuration my coding agents load: extensions, skills, prompts and themes. It is one
      native <strong class="text-[var(--fg)]">pi</strong> package, with tests and CI.
    </p>
    <p class="mt-3 text-[15px] text-[var(--fg-muted)]">
      The same extensions run under <strong class="text-[var(--fg)]">OpenCode V2</strong>. Each
      feature is defined once, and a thin adapter connects it to the harness.
    </p>
  </ProjectSection>

  <ProjectSection n="02" title="Shape">
    <ProjectRows items={rows} />
  </ProjectSection>

  <ProjectSection n="03" title="Design ideas">
    <ProjectIdeas items={ideas} />
  </ProjectSection>

  <p slot="note">
    The repository is private; this page is its public summary. The phone setup is <a
      href="/droidfiles/"
      class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors"
      >droidfiles</a
    >.
  </p>
</ProjectPage>
