---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="About" slug="about">
  <div class="flex flex-col items-center text-center">
    <div class="gradient-border rounded-full p-[3px] my-8">
      <img
        class="rounded-full animate-fadeInColor shadow-lg"
        src="https://www.gravatar.com/avatar/b6500b41998cd1ed4aa28464ec0118bb?s=160"
        alt="Aniket Pant"
        width="160"
        height="160"
        loading="eager"
      />
    </div>

    <p class="lead text-lg md:text-xl my-4 max-w-xl">
      Hey, I am <strong class="text-[var(--fg)]">Aniket</strong> and I have been around on the web since 2010. It's not long but it has been an{' '}
      <a href="/archive/" class="text-[var(--color-brand)] hover:underline underline-offset-4">adventure</a> since then.
    </p>

    <p class="my-4 text-[var(--fg-muted)] max-w-xl">
      You can reach out via a{' '}
      <a href="https://x.com/noremap" class="text-[var(--color-brand)] hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">message on X</a>{' '}
      or{' '}
      <a href="mailto:me@aniketpant.com?subject=Hey!" class="text-[var(--color-brand)] hover:underline underline-offset-4">drop an email</a>.
    </p>

    <hr class="my-10 w-16 border-[var(--border)]" />

    <p class="text-sm text-[var(--fg-subtle)]">
      This site is built with{' '}
      <a href="https://astro.build" class="text-[var(--color-brand)] hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">Astro</a>,{' '}
      <a href="https://tailwindcss.com" class="text-[var(--color-brand)] hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">Tailwind CSS</a>,{' '}
      and hosted on{' '}
      <a href="https://github.com" class="text-[var(--color-brand)] hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">GitHub Pages</a>.
    </p>
  </div>
</PageLayout>
