---
import ProjectPage from '../components/ProjectPage.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ProjectRows from '../components/ProjectRows.astro';
import ProjectIdeas from '../components/ProjectIdeas.astro';

const chips = [
  { label: 'public', hot: true },
  { label: 'zsh' },
  { label: 'gnu stow' },
  { label: 'ghostty' },
  { label: 'keyd' },
];

const spec = [
  { k: 'Role', v: 'Shell and terminal setup', note: 'on Ubuntu' },
  { k: 'Runs on', v: 'Ubuntu, with a macOS key layer' },
  { k: 'Built with', v: 'Zsh, GNU Stow, a Makefile' },
];

const rows = [
  { path: 'zsh/', text: 'Options, aliases, functions, zinit in turbo mode' },
  { path: 'ghostty/', text: 'Terminal config and themes, light and dark' },
  { path: 'keyd/', text: 'A global Cmd layer and per-app masks' },
  { path: 'git/', text: 'Global config, ignore file, commit message template' },
  { path: 'bin/', text: 'Git helper scripts, stowed into ~/bin' },
  { path: 'starship/', text: 'Prompt config' },
  { path: 'pi/ opencode/', text: 'TUI settings' },
  { path: 'scripts/', text: 'Package, keybinding and keyd installers' },
];

const ideas = [
  {
    title: 'Stow, one folder per tool',
    text: 'Each tool has a folder that mirrors its path in the home directory. make install stows them, make clean unstows them. System packages are installed by scripts, not by stow.',
  },
  {
    title: 'One palette for shell and TUI',
    text: 'Ghostty, pi and opencode all follow the system theme. The terminal themes are generated from pi\u2019s bundled colours, so the two use the same values.',
  },
  {
    title: 'Cmd on Linux, and what breaks',
    text: 'A keyd layer maps Cmd to Ctrl globally, with a per-app mask so the terminal keeps its own shortcuts. Redefining Super replaces GNOME\u2019s chords. The README lists the bindings that do not fire.',
  },
  {
    title: 'Startup measured',
    text: 'Plugins load through zinit in turbo mode and are deferred until first use. Shell startup stays near 0.6 seconds.',
  },
];
---

<ProjectPage
  title="dotfiles"
  repo="dotfiles"
  lede="Zsh, Ghostty and keyd, stowed onto a new machine."
  description="A Zsh, Ghostty and keyd setup managed with GNU Stow: one palette across the shell and the TUI, and macOS keybindings ported to Linux."
  chips={chips}
  spec={spec}
>
  <ProjectSection n="01" title="Background">
    <p class="mt-2 text-[15px] text-[var(--fg-muted)]">
      My shell and terminal setup, kept in a repository so a reinstall does not erase it.
    </p>
    <p class="mt-3 text-[15px] text-[var(--fg-muted)]">
      Zsh with a fast startup, a terminal configured the same way on each machine, and a Cmd key
      layer for Linux. <a
        href="/droidfiles/"
        class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors"
        >droidfiles</a
      > is the phone;{' '}
      <a
        href="/botfiles/"
        class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors"
        >botfiles</a
      > is the agent.
    </p>
  </ProjectSection>

  <ProjectSection n="02" title="Shape">
    <ProjectRows items={rows} />
  </ProjectSection>

  <ProjectSection n="03" title="Design ideas">
    <ProjectIdeas items={ideas} />
  </ProjectSection>

  <p slot="note">
    The repository is public: <a
      href="https://github.com/aniketpant/dotfiles"
      class="text-[var(--color-tertiary)] hover:text-[var(--color-tertiary-hover)] hover:underline underline-offset-4 transition-colors"
      target="_blank"
      rel="noopener noreferrer">github.com/aniketpant/dotfiles</a
    >. The README has the install steps and the known trade-offs.
  </p>
</ProjectPage>
