---
interface Props {
  title: string;
  decoColor?: string;
  center?: boolean;
  /** Let the title row use the full content width (long titles next to an aside). */
  wideHeader?: boolean;
  showGradientLine?: boolean;
  titleAttrs?: Record<string, string>;
}

const {
  title,
  decoColor = 'var(--color-brand)',
  center = false,
  wideHeader = false,
  showGradientLine = false,
  titleAttrs = {},
} = Astro.props;
---

<div class="animate-fade-in relative">
  {/* A full-viewport wash rather than one blob: the colour holds behind the
      header, spreads down the page and fades out before the footer. */}
  <div class="deco-wash" style={`--deco: ${decoColor};`} aria-hidden="true" />

  <header class="pt-16 md:pt-24 pb-8 md:pb-12">
    <div class="mx-auto max-w-5xl px-6 md:px-8 relative">
      <div class={center ? 'max-w-3xl text-center mx-auto' : wideHeader ? 'max-w-5xl' : 'max-w-3xl'}>
        <slot name="header-meta" />
        <div class="flex items-center justify-between gap-4 md:gap-8">
          <h1
            class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] md:leading-[1.05] tracking-tight gradient-text min-w-0"
            {...titleAttrs}
          >
            {title}
          </h1>
          <div class="shrink-0"><slot name="header-aside" /></div>
        </div>
        <slot name="header-extra" />
        {showGradientLine && <div class="gradient-line mt-6 w-20" aria-hidden="true"></div>}
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-5xl px-6 md:px-8 pb-16 md:pb-24">
    {
      center ? (
        <div class="max-w-xl mx-auto">
          <slot name="body">
            <div class="prose prose-slate prose-lg md:prose-base max-w-[42rem] mx-auto text-center">
              <slot />
            </div>
          </slot>
        </div>
      ) : (
        <div class="max-w-[42rem]">
          <slot name="body">
            <div class="prose prose-slate prose-lg md:prose-base max-w-none">
              <slot />
            </div>
          </slot>
        </div>
      )
    }
  </div>
</div>
