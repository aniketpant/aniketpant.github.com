---
interface Props {
  title: string;
  decoColor?: string;
  center?: boolean;
  showGradientLine?: boolean;
  titleAttrs?: Record<string, string>;
}

const {
  title,
  decoColor = 'var(--color-brand)',
  center = false,
  showGradientLine = false,
  titleAttrs = {},
} = Astro.props;
---

<div class="animate-fade-in relative overflow-hidden">
  <div
    class="deco-blob w-[500px] h-[600px] -top-40 -right-40"
    style={`background-color: ${decoColor}; opacity: 0.08;`}
    aria-hidden="true"
  />

  <header class="pt-16 md:pt-24 pb-12 md:pb-16">
    <div class="mx-auto max-w-5xl px-6 md:px-8 relative">
      <div class={center ? 'max-w-3xl text-center mx-auto' : 'max-w-3xl'}>
        <slot name="header-meta" />
        <h1
          class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] md:leading-[1.05] tracking-tight gradient-text"
          {...titleAttrs}
        >
          {title}
        </h1>
        <slot name="header-extra" />
        {showGradientLine && <div class="gradient-line mt-6 w-20" aria-hidden="true"></div>}
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-5xl px-6 md:px-8 pb-16 md:pb-24">
    {
      center ? (
        <div class="max-w-xl mx-auto">
          <slot name="body">
            <div class="prose prose-slate prose-lg md:prose-base max-w-none text-center">
              <slot />
            </div>
          </slot>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
          <div class="hidden md:block md:col-span-1">
            <div class="gradient-line-vertical h-24 sticky top-24 mx-auto" aria-hidden="true" />
          </div>
          <div class="md:col-span-8">
            <slot name="body">
              <div class="prose prose-slate prose-lg md:prose-base max-w-none">
                <slot />
              </div>
            </slot>
          </div>
          <div class="hidden md:block md:col-span-3" />
        </div>
      )
    }
  </div>
</div>
