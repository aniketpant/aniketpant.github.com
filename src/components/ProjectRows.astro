---
interface Row {
  path: string;
  text: string;
}

interface Props {
  items: Row[];
}

const { items } = Astro.props;
---

<div class="mt-3.5 border-t border-[var(--border)]">
  {
    items.map((row) => (
      <div class="grid grid-cols-1 sm:grid-cols-[190px_1fr] gap-x-4 gap-y-0.5 items-baseline py-3 border-b border-[var(--border)]">
        <code class="font-mono text-[13px] font-medium text-[var(--fg)]">{row.path}</code>
        <p class="m-0 text-[13.5px] text-[var(--fg-muted)]">{row.text}</p>
      </div>
    ))
  }
</div>
