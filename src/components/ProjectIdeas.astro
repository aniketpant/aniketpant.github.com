---
interface Idea {
  title: string;
  text: string;
}

interface Props {
  items: Idea[];
}

const { items } = Astro.props;
---

<div class="mt-4 border-t border-[var(--border)]">
  {
    items.map((idea, index) => (
      <div class="flex gap-4 py-4 border-b border-[var(--border)]">
        <span
          class="mt-0.5 font-mono text-[11px] text-[var(--fg-subtle)] tabular-nums shrink-0"
          aria-hidden="true"
        >
          {String(index + 1).padStart(2, '0')}
        </span>
        <div>
          <h3 class="m-0 text-[15px] font-semibold text-[var(--fg)]">{idea.title}</h3>
          <p class="mt-1 text-[14px] leading-relaxed text-[var(--fg-muted)]">{idea.text}</p>
        </div>
      </div>
    ))
  }
</div>
