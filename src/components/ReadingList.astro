---
// Currently reading, from a Goodreads shelf snapshot.
//
// The site is static, so the page reads src/data/reading.json, which
// scripts/goodreads.mjs refreshes. Nothing here calls Goodreads at runtime,
// and an empty snapshot renders nothing at all.
import reading from '../data/reading.json';

interface Book {
  title: string;
  author: string | null;
  link: string;
  cover: string | null;
  added: string | null;
}

const { books, user } = reading as { books: Book[]; user: string | null };

// Four fit one screen beside the writing lists; the shelf link carries the rest.
const shown = books.slice(0, 4);
const profile = user
  ? `https://www.goodreads.com/user/show/${user}`
  : 'https://www.goodreads.com';
---

{
  shown.length > 0 && (
    <section aria-label="Currently reading" class="pb-16 md:pb-24">
      <div class="flex items-baseline gap-4 mb-8">
        <h2 class="eyebrow">Reading</h2>
        <div class="flex-1 h-px bg-[var(--border)]" />
        <a
          href={profile}
          rel="me noopener noreferrer"
          target="_blank"
          class="eyebrow hover:text-[var(--color-brand)] transition-colors"
        >
          Goodreads
        </a>
      </div>

      <ul class="m-0 list-none p-0 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5">
        {shown.map((book) => (
          <li class="m-0">
            <a
              href={book.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex gap-3 items-start"
            >
              {book.cover && (
                <img
                  src={book.cover}
                  alt=""
                  width="40"
                  height="60"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="w-10 h-[60px] shrink-0 rounded-[3px] border border-[var(--border)] object-cover"
                />
              )}
              <span class="min-w-0">
                <span class="block text-[14.5px] font-medium leading-snug text-[var(--fg)] group-hover:text-[var(--color-brand)] transition-colors duration-200">
                  {book.title}
                </span>
                {book.author && (
                  <span class="mt-0.5 block text-[13px] leading-snug text-[var(--fg-muted)]">
                    {book.author}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
