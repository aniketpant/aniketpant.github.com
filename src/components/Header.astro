---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const navItems = [
  { label: 'About', href: '/about/' },
  { label: 'Speaking', href: '/speaking/' },
  { label: 'Archive', href: '/archive/' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-[var(--bg)]/70 border-b border-[var(--border)]" role="banner">
  <div class="mx-auto max-w-5xl px-6 md:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex-shrink-0">
        {isHome ? (
          <h1 class="text-lg font-semibold tracking-tight">
            <a href="/" rel="nofollow" class="group flex items-baseline gap-0.5 text-[var(--fg)] hover:opacity-70 transition-opacity duration-200">
              <span class="gradient-text-subtle">no</span><span>remap</span>
            </a>
          </h1>
        ) : (
          <a href="/" rel="nofollow" class="group flex items-baseline gap-0.5 text-lg font-semibold tracking-tight text-[var(--fg)] hover:opacity-70 transition-opacity duration-200">
            <span class="gradient-text-subtle">no</span><span>remap</span>
          </a>
        )}
      </div>

      <div class="flex items-center gap-1">
        <nav aria-label="Main navigation">
          <ul class="flex items-center gap-0.5">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="px-3 py-2 rounded-lg text-sm font-medium text-[var(--fg-muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-secondary)] transition-all duration-200"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="ml-3 pl-3 border-l border-[var(--border)]">
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</header>
