---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navItems = [
  { label: 'Projects', href: '/projects/' },
  { label: 'About', href: '/about/' },
  { label: 'Speaking', href: '/speaking/' },
  { label: 'Archive', href: '/archive/' },
];
---

<header
  class="sticky top-0 z-50 backdrop-blur-xl bg-[var(--bg)]/70 border-b border-[var(--border)]"
  role="banner"
>
  <div class="mx-auto max-w-5xl px-5 sm:px-6 md:px-8">
    <!-- Wraps on small screens: the wordmark and the toggle share the first
         row, the links get a row of their own. Four links plus both controls
         need about 412px on one line, which no phone has. -->
    <div class="flex flex-wrap items-center justify-between gap-y-1 py-2 sm:h-16 sm:py-0">
      <div class="flex-shrink-0">
        {isHome ? (
          <h1 class="text-base sm:text-lg font-semibold tracking-tight">
            <a
              href="/"
              rel="nofollow"
              class="group flex items-baseline gap-0.5 text-[var(--fg)] hover:opacity-70 transition-opacity duration-200"
            >
              <span class="gradient-text-subtle">no</span><span>remap</span>
            </a>
          </h1>
        ) : (
          <a
            href="/"
            rel="nofollow"
            class="group flex items-baseline gap-0.5 text-base sm:text-lg font-semibold tracking-tight text-[var(--fg)] hover:opacity-70 transition-opacity duration-200"
          >
            <span class="gradient-text-subtle">no</span><span>remap</span>
          </a>
        )}
      </div>

      <nav aria-label="Main navigation" class="order-3 w-full sm:order-2 sm:w-auto">
        <ul class="flex items-center gap-0.5 overflow-x-auto">
          {
            navItems.map((item) => {
              const isCurrent = pathname === item.href.replace(/\/$/, '');
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent ? 'page' : undefined}
                    class:list={[
                      'block px-2 sm:px-3 py-2 rounded-lg text-[13px] sm:text-sm font-medium whitespace-nowrap transition-all duration-200',
                      isCurrent
                        ? 'text-[var(--fg)] bg-[var(--bg-secondary)]'
                        : 'text-[var(--fg-muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-secondary)]',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="order-2 sm:order-3 flex items-center sm:ml-3 sm:pl-3 sm:border-l sm:border-[var(--border)]">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
