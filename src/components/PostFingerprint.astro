---
import {
  ditherRuns,
  fingerprintTraits,
  inkRatio,
  runsMarkup,
  swatchesForRamp,
  SWATCHES,
  SWATCHES_DARK,
  type Swatch,
} from '../utils/dither';
import { djb2, hashValues } from '../utils/hash';
import type { FieldName, PaletteKey } from '../utils/dither';

interface Props {
  seed: string;
  size?: number;
  class?: string;
  /** Override the grid: fewer cells stay legible at small display sizes. */
  grid?: number;
  /** Silhouette the marks are cut to. A row of three reads better as circle,
      triangle, rectangle than as three identical squares. */
  shape?: 'square' | 'circle' | 'triangle';
}

const { seed, shape = 'square' } = Astro.props;
const size = Astro.props.size ?? 96;
const className = Astro.props.class ?? '';

// Deterministic choices per post. The traits live in utils/dither so a row of
// marks can be checked for repeats before anything renders.
const traits = fingerprintTraits(seed);
const clipId = `mark-${shape}-${djb2(seed).toString(36)}`;
const field = traits.field;
const stops = traits.stops;
const GRID = Astro.props.grid ?? traits.grid;
// Quantize against the swatches this mark's ramp names, and nothing else.
// Offering the whole palette to every ramp let desaturated mid-blends snap to
// the grey swatch and lay dark slabs over the page; naming them keeps a colour
// ramp clean and lets an ink or grey ramp be chosen on purpose.
const fpLight = swatchesForRamp(stops, SWATCHES);
const fpDark = swatchesForRamp(stops, SWATCHES_DARK);

// Pull the saturated centre of a field back toward the page so the tile reads
// as marks rather than a filled square; the exact amount varies per post.
const GAMMAS = [1.25, 1.4, 1.55];
const gamma = GAMMAS[hashValues(seed + ':gamma', 1, GAMMAS.length)[0]]!;
// The triangle silhouette loses its corners to the clip, so it takes a little
// more ink than the square to read at the same weight.
const shapeInk = shape === 'triangle' ? -0.45 : 0;
// Smooth fields (blobs, clouds) are folded into nested contour bands so they
// read as drawn lines; inherently rhythmic fields (stripes, checker, plaid)
// are left alone, because they already carry their own structure.
const SMOOTH: FieldName[] = ['swell', 'core', 'bloom', 'ridge', 'hero', 'dusk'];
const BANDS = [3, 4, 5];
const bands = SMOOTH.includes(field)
  ? BANDS[hashValues(seed + ':bands', 1, BANDS.length)[0]]!
  : 1;
const base = {
  cols: GRID,
  rows: GRID,
  field,
  stops,
  seed,
  edgeFade: 0.4,
  bands,
};
// A heavy gamma can leave a tile almost empty. Measure the ink and lift the
// gamma back down when too little of the tile is drawn, so every post keeps a
// mark of its own without hand-tuning any seed.
let opts = { ...base, gamma: gamma + shapeInk };
if (inkRatio(ditherRuns({ ...opts, palette: fpLight })) < 0.18) {
  opts = { ...base, gamma: Math.max(1, gamma + shapeInk - 0.45) };
}

// Quantize once per theme so the pattern stays perceptually aligned under
// both the light and dark palettes; fills are emitted as var() so colors
// follow whichever theme is active. A single <g> is revealed via CSS.
// `bg` cells are skipped entirely — there is no background rect, so the
// site's own background shows through and the tile's edge naturally dissolves.
const markupLight = runsMarkup(ditherRuns({ ...opts, palette: fpLight }), {
  skipBg: true,
});
const markupDark = runsMarkup(ditherRuns({ ...opts, palette: fpDark }), {
  skipBg: true,
});
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${GRID} ${GRID}`}
  width={size}
  height={size}
  class={`select-none ${className}`}
  aria-hidden="true"
  shape-rendering="crispEdges"
>
  {
    shape !== 'square' && (
      <defs>
        <clipPath id={clipId}>
          {shape === 'circle' ? (
            <circle cx={GRID / 2} cy={GRID / 2} r={GRID / 2} />
          ) : (
            <polygon
              points={`${GRID / 2},0.5 ${GRID - 0.5},${GRID - 1} 0.5,${GRID - 1}`}
            />
          )}
        </clipPath>
      </defs>
    )
  }
  <g
    class="fingerprint-dither"
    clip-path={shape === 'square' ? undefined : `url(#${clipId})`}
  >
    <Fragment set:html={markupLight} />
  </g>
  <g
    class="fingerprint-dither-dark"
    clip-path={shape === 'square' ? undefined : `url(#${clipId})`}
  >
    <Fragment set:html={markupDark} />
  </g>
</svg>
