---
import { ditherRuns, runsMarkup, SWATCHES, SWATCHES_DARK, type Swatch } from '../utils/dither';
import { hashValues } from '../utils/hash';
import type { FieldName, PaletteKey } from '../utils/dither';

interface Props {
  seed: string;
  size?: number;
  class?: string;
}

const { seed } = Astro.props;
const size = Astro.props.size ?? 120;
const className = Astro.props.class ?? '';

// Deterministic choices per post: a field flavor and a ramp of palette stops.
const FIELD_NAMES: FieldName[] = ['swell', 'plaid', 'core', 'dusk'];
const field = FIELD_NAMES[hashValues(seed + ':field', 1, FIELD_NAMES.length)[0]]!;

// Every ramp starts (and mostly ends) at `bg` so each tile grounds itself in
// the site's own background and sweeps toward a hue — the pattern merges with
// the page instead of stacking a second background color on top of it.
const STOP_SETS: PaletteKey[][] = [
  ['bg', 'brand'],
  ['bg', 'secondary'],
  ['bg', 'tertiary'],
  ['bg', 'brand', 'bg'],
  ['bg', 'secondary', 'bg'],
  ['bg', 'tertiary', 'bg'],
];
const stops = STOP_SETS[hashValues(seed + ':stops', 1, STOP_SETS.length)[0]]!;

// Quantize against the colorful swatches only (bg + the three accents) —
// never against `fg`/`muted`. Without this, desaturated mid-blends between
// two hues snap to the gray `muted` swatch and lay dark slabs over the page
// (the "dark background that fights the light theme").
const FP_KEYS: PaletteKey[] = ['bg', 'brand', 'secondary', 'tertiary'];
const huesOnly = (list: Swatch[]) => list.filter((s) => FP_KEYS.includes(s.key));
const fpLight = huesOnly(SWATCHES);
const fpDark = huesOnly(SWATCHES_DARK);

const GRID = 32;
const opts = { cols: GRID, rows: GRID, field, stops, seed, edgeFade: 0.4 };

// Quantize once per theme so the pattern stays perceptually aligned under
// both the light and dark palettes; fills are emitted as var() so colors
// follow whichever theme is active. A single <g> is revealed via CSS.
// `bg` cells are skipped entirely — there is no background rect, so the
// site's own background shows through and the tile's edge naturally dissolves.
const markupLight = runsMarkup(ditherRuns({ ...opts, palette: fpLight }), { skipBg: true });
const markupDark = runsMarkup(ditherRuns({ ...opts, palette: fpDark }), { skipBg: true });
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${GRID} ${GRID}`}
  width={size}
  height={size}
  class={`select-none ${className}`}
  aria-hidden="true"
  shape-rendering="crispEdges"
>
  <g class="fingerprint-dither">
    <Fragment set:html={markupLight} />
  </g>
  <g class="fingerprint-dither-dark">
    <Fragment set:html={markupDark} />
  </g>
</svg>