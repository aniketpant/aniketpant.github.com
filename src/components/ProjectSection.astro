---
interface Props {
  n: string;
  title: string;
}

const { n, title } = Astro.props;
---

<h2 class="mt-9 mb-1 font-serif text-[22px] font-semibold tracking-tight text-[var(--fg)]">
  <span class="block mb-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--fg-subtle)]">{n}</span>
  {title}
</h2>
<slot />
