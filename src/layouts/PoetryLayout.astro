---
import BaseLayout from './BaseLayout.astro';
import type { ProcessedPost } from '../utils/posts';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt} slug={post.slug}>
  <article class="animate-fade-in">
    <header class="relative pt-16 md:pt-24 pb-12 md:pb-16 overflow-hidden">
      <div class="deco-blob bg-[var(--color-tertiary)] w-[400px] h-[400px] -top-32 -right-32 opacity-[0.08]" aria-hidden="true"></div>

      <div class="mx-auto max-w-5xl px-6 md:px-8 relative">
        <div class="max-w-3xl text-center mx-auto">
          <div class="flex items-center justify-center gap-3 text-sm text-[var(--fg-subtle)] mb-6">
            <time datetime={post.isoDate}>{post.formattedDate}</time>
          </div>
          <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight gradient-text">
            {post.title}
          </h1>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-6 md:px-8 pb-16 md:pb-24">
      <div class="max-w-xl mx-auto">
        <div class="prose prose-slate prose-lg md:prose-base max-w-none text-center">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
