---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  slug?: string;
  isHome?: boolean;
}

const {
  title = 'Aniket Pant',
  description = 'Aniket is a full stack developer who loves Go and JavaScript.',
  slug = '',
  isHome = false,
} = Astro.props;

const siteTitle = isHome
  ? 'Aniket Pant'
  : `${title} | Aniket Pant`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.aniketpant.com');
const imageURL = new URL('/images/logo.jpg', Astro.site || 'https://www.aniketpant.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Aniket Pant" />

    <title>{siteTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" href="/feed/index.xml" title="Aniket Pant" type="application/rss+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" title="Sitemap" type="application/xml" />

    <meta property="og:title" content={title} />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:site_name" content="Aniket Pant" />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@noremap" />
    <meta name="twitter:creator" content="@noremap" />

    <ClientRouter />

    <script is:inline>
      (function () {
        function applyTheme() {
          const theme =
            (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col">
    <Header isHome={isHome} />

    <main class="flex-1 w-full overflow-x-hidden">
      <slot />
    </main>

    <footer class="mt-auto">
      <div class="gradient-line" aria-hidden="true"></div>
      <div class="py-8 text-center text-sm text-[var(--fg-subtle)]">
        <div class="mx-auto max-w-5xl px-6 md:px-8">
          <p>
            &copy; {new Date().getFullYear()} Aniket Pant. Built with{' '}
            <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-[var(--color-brand)] hover:underline">Astro</a>{' '}
            &{' '}
            <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-brand)] hover:underline">Tailwind</a>.
          </p>
          <p class="mt-2">
            <a href="/feed/index.xml" class="hover:text-[var(--fg-muted)] transition-colors">RSS</a>
            <span class="mx-2 text-[var(--border)]">·</span>
            <a href="/sitemap-index.xml" class="hover:text-[var(--fg-muted)] transition-colors">Sitemap</a>
            <span class="mx-2 text-[var(--border)]">·</span>
            <a href="https://x.com/noremap" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--fg-muted)] transition-colors">@noremap</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
