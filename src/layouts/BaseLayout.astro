---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  slug?: string;
  isHome?: boolean;
}

const {
  title = 'Aniket Pant',
  description = 'Aniket is a full stack developer who loves Go and JavaScript.',
  slug = '',
  isHome = false,
} = Astro.props;

const siteTitle = isHome
  ? 'Aniket Pant'
  : `${title} | Aniket Pant's Website`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.aniketpant.com');
const imageURL = new URL('/images/logo.jpg', Astro.site || 'https://www.aniketpant.com');
---

<!doctype html>
<html lang="en" class="text-slate-900 bg-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="aniket, pant, noremap, weblog, css, php, html, javascript, web development, code" />
    <meta name="author" content="Aniket Pant" />
    <meta name="twitter:site" content="@noremap" />
    <meta name="twitter:creator" content="@noremap" />

    <title>{siteTitle}</title>

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" href="/feed/index.xml" title="Aniket Pant" type="application/rss+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" title="Sitemap" type="application/xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content={isHome ? 'blog' : 'article'} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:site_name" content="Aniket Pant" />

    <!-- Google Fonts: Inter and Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,600;0,700;1,300&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased min-h-screen">
    <Header isHome={isHome} />

    <main class="flex md:container md:mx-auto">
      <div class="mx-8 md:mx-auto w-full">
        <slot />
      </div>
    </main>
  </body>
</html>
