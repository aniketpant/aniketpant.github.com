---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  slug?: string;
  isHome?: boolean;
  noindex?: boolean;
  publishedTime?: string;
}

const {
  title = 'Aniket Pant',
  description = 'Aniket is a full stack developer who loves Go and JavaScript.',
  slug = '',
  isHome = false,
  noindex = false,
  publishedTime,
} = Astro.props;

const siteTitle = isHome ? 'Aniket Pant' : `${title} | Aniket Pant`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.aniketpant.com');
const imageURL = new URL('/og-default.png', Astro.site || 'https://www.aniketpant.com');
const ogType = publishedTime ? 'article' : 'website';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <!-- Let the browser theme native UI and the initial canvas before paint.
         The inline script below keeps both in sync with the stored choice. -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f5" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline>
      (function () {
        var KEY = 'theme';
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');

        function stored() {
          try {
            return localStorage.getItem(KEY);
          } catch (e) {
            return null;
          }
        }

        function preference() {
          var value = stored();
          return value === 'light' || value === 'dark' ? value : null;
        }

        function resolved() {
          return preference() || (mq.matches ? 'dark' : 'light');
        }

        function apply() {
          var pref = preference();
          var theme = pref || (mq.matches ? 'dark' : 'light');
          root.setAttribute('data-theme', theme);

          var scheme = document.querySelector('meta[name="color-scheme"]');
          if (scheme) scheme.setAttribute('content', pref || 'light dark');

          var bar = document.querySelector('meta[name="theme-color"]');
          if (bar) bar.setAttribute('content', theme === 'dark' ? '#070514' : '#faf8f5');

          var toggle = document.getElementById('theme-toggle');
          if (toggle) {
            toggle.setAttribute(
              'aria-label',
              theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
            );
          }
        }

        window.__applyTheme = apply;

        // Two visible states: follow the system (no stored value) or pin the
        // opposite of what is currently rendered. Returning to the system
        // preference removes the stored value instead of pinning it.
        window.__toggleTheme = function () {
          var next = resolved() === 'dark' ? 'light' : 'dark';
          try {
            if (next === (mq.matches ? 'dark' : 'light')) {
              localStorage.removeItem(KEY);
            } else {
              localStorage.setItem(KEY, next);
            }
          } catch (e) {
            /* Storage can be blocked; still apply the theme for this page. */
          }

          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (document.startViewTransition && !reduce) {
            try {
              document.startViewTransition(apply);
              return;
            } catch (e) {
              /* A transition is already running; apply directly instead. */
            }
          }
          apply();
        };

        apply();
        document.addEventListener('astro:after-swap', apply);
        document.addEventListener('astro:page-load', apply);

        // Keep the page in sync with OS changes while following the system.
        mq.addEventListener('change', function () {
          if (!preference()) apply();
        });

        // Keep other tabs in sync with an explicit choice.
        window.addEventListener('storage', function (event) {
          if (event.key === KEY) apply();
        });
      })();
    </script>

    <title>{siteTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" href="/feed/index.xml" title="Aniket Pant" type="application/rss+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" title="Sitemap" type="application/xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:alt" content="Aniket Pant" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Aniket Pant" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:description" content={description} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@noremap" />
    <meta name="twitter:creator" content="@noremap" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />
    <meta name="twitter:image:alt" content="Aniket Pant" />

    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to main content</a>

    <Header isHome={isHome} />

    <main id="main" tabindex="-1" class="flex-1 w-full overflow-x-hidden">
      <slot />
    </main>

    <footer class="mt-auto">
      <div class="gradient-line" aria-hidden="true"></div>
      <div class="py-8 text-center text-sm text-[var(--fg-subtle)]">
        <div class="mx-auto max-w-5xl px-6 md:px-8">
          <p>
            &copy; {new Date().getFullYear()} Aniket Pant. Built with{' '}
            <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-[var(--color-secondary)] hover:text-[var(--color-secondary-hover)] hover:underline transition-colors">Astro</a>{' '}
            &{' '}
            <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-secondary)] hover:text-[var(--color-secondary-hover)] hover:underline transition-colors">Tailwind</a>.
          </p>
          <p class="mt-2">
            <a href="/feed/index.xml" class="hover:text-[var(--fg-muted)] transition-colors">RSS</a>
            <span class="mx-2 text-[var(--border)]">·</span>
            <a href="/sitemap-index.xml" class="hover:text-[var(--fg-muted)] transition-colors">Sitemap</a>
            <span class="mx-2 text-[var(--border)]">·</span>
            <a href="https://x.com/noremap" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--fg-muted)] transition-colors">@noremap</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
