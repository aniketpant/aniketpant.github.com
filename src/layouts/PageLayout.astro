---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  slug?: string;
  description?: string;
}

const { title, slug = '', description } = Astro.props;
---

<BaseLayout title={title} slug={slug} description={description}>
  <div class={`prose prose-slate ${slug} text-lg md:text-base mx-auto`}>
    <header class="mb-8">
      <h1 class="text-center">{title}</h1>
    </header>

    <article role="main" class="flex flex-col justify-center items-center text-center">
      <slot />
    </article>
  </div>
</BaseLayout>
