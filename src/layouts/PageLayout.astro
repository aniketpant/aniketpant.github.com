---
import BaseLayout from './BaseLayout.astro';
import ArticleShell from '../components/ArticleShell.astro';

interface Props {
  title: string;
  slug?: string;
  description?: string;
}

const { title, slug = '', description } = Astro.props;
---

<BaseLayout title={title} slug={slug} description={description}>
  <ArticleShell title={title} decoColor="var(--color-secondary)" showGradientLine>
    <slot />
  </ArticleShell>
</BaseLayout>
