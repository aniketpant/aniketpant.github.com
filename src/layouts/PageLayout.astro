---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  slug?: string;
  description?: string;
}

const { title, slug = '', description } = Astro.props;
---

<BaseLayout title={title} slug={slug} description={description}>
  <div class="py-10 md:py-14 animate-fade-in">
    <header class="mb-10 text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-semibold leading-tight text-[var(--fg)]">
        {title}
      </h1>
    </header>

    <article class="prose prose-slate prose-lg md:prose-base max-w-none">
      <slot />
    </article>
  </div>
</BaseLayout>
