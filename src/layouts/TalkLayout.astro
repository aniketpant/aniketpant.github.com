---
import BaseLayout from './BaseLayout.astro';
import type { ProcessedPost } from '../utils/posts';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const event = post.entry.data.event;
const link = post.entry.data.link;
---

<BaseLayout title={post.title} description={post.excerpt} slug={post.slug}>
  <article class="py-10 md:py-14 animate-fade-in" itemscope itemtype="http://schema.org/Event">
    <header class="mb-10 text-center">
      <div class="flex items-center justify-center gap-3 text-sm text-[var(--fg-subtle)] mb-4">
        <time datetime={post.isoDate} itemprop="startDate">{post.formattedDate}</time>
        {post.readingTime && (
          <>
            <span class="w-1 h-1 rounded-full bg-[var(--fg-subtle)]" aria-hidden="true"></span>
            <span>{post.readingTime}</span>
          </>
        )}
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-semibold leading-tight text-[var(--fg)]" itemprop="name">
        {post.title}
      </h1>
      {event && (
        <h2 class="mt-3 text-xl font-normal text-[var(--fg-muted)]">{event}</h2>
      )}
      {link && (
        <a
          href={link}
          itemprop="url"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-3 text-[var(--color-brand)] hover:underline"
        >
          Event website
        </a>
      )}
    </header>

    <div class="prose prose-slate prose-lg md:prose-base max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
