---
import BaseLayout from './BaseLayout.astro';
import ArticleShell from '../components/ArticleShell.astro';
import type { ProcessedPost } from '../utils/posts';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const event = post.entry.data.event;
const link = post.entry.data.link;
---

<BaseLayout title={post.title} description={post.excerpt} slug={post.slug}>
  <article itemscope itemtype="http://schema.org/Event">
    <ArticleShell
      title={post.title}
      decoColor="var(--color-secondary)"
      titleAttrs={{ itemprop: 'name' }}
    >
      <div slot="header-meta" class="flex items-center gap-3 text-sm text-[var(--fg-subtle)] mb-6">
        <time datetime={post.isoDate} itemprop="startDate">{post.formattedDate}</time>
        {
          post.readingTime && (
            <>
              <span class="w-1 h-1 rounded-full bg-[var(--fg-subtle)]" aria-hidden="true" />
              <span>{post.readingTime}</span>
            </>
          )
        }
      </div>

      <div slot="header-extra">
        {event && <h2 class="mt-4 text-xl md:text-2xl font-normal text-[var(--fg-muted)]">{event}</h2>}
        {
          link && (
            <a
              href={link}
              itemprop="url"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 mt-4 text-[var(--color-brand)] hover:underline underline-offset-4 text-sm font-medium"
            >
              Event website
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
          )
        }
      </div>

      <slot />
    </ArticleShell>
  </article>
</BaseLayout>
