---
import BaseLayout from './BaseLayout.astro';
import ArticleShell from '../components/ArticleShell.astro';
import type { ProcessedPost } from '../utils/posts';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt} slug={post.slug}>
  <article>
    <ArticleShell title={post.title} decoColor="var(--color-brand)">
      <div slot="header-meta" class="flex items-center gap-3 text-sm text-[var(--fg-subtle)] mb-6">
        <time datetime={post.isoDate}>{post.formattedDate}</time>
        <span class="w-1 h-1 rounded-full bg-[var(--fg-subtle)]" aria-hidden="true"></span>
        <span>{post.readingTime}</span>
      </div>
      <slot />
    </ArticleShell>
  </article>
</BaseLayout>
