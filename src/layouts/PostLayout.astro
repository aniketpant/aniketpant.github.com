---
import BaseLayout from './BaseLayout.astro';
import type { ProcessedPost } from '../utils/posts';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt} slug={post.slug}>
  <article class="py-10 md:py-14 animate-fade-in">
    <!-- Post header -->
    <header class="mb-10 text-center">
      <div class="flex items-center justify-center gap-3 text-sm text-[var(--fg-subtle)] mb-4">
        <time datetime={post.isoDate}>{post.formattedDate}</time>
        <span class="w-1 h-1 rounded-full bg-[var(--fg-subtle)]" aria-hidden="true"></span>
        <span>{post.readingTime}</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-semibold leading-tight text-[var(--fg)]">
        {post.title}
      </h1>
    </header>

    <!-- Content -->
    <div class="prose prose-slate prose-lg md:prose-base max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
