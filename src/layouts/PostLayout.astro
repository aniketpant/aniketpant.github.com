---
import BaseLayout from './BaseLayout.astro';
import ArticleShell from '../components/ArticleShell.astro';
import PostFingerprint from '../components/PostFingerprint.astro';
import { distinctFingerprintSeeds } from '../utils/dither';
import type { ProcessedPost } from '../utils/posts';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;

// Three marks for this post, guaranteed to differ from one another.
const marks = distinctFingerprintSeeds(post.id, 3);
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  slug={post.slug}
  publishedTime={post.isoDate}
>
  <article>
    <ArticleShell title={post.title} decoColor="var(--color-brand)" wideHeader>
      <div slot="header-meta" class="meta flex items-center gap-3 mb-6">
        <time datetime={post.isoDate}>{post.formattedDate}</time>
        <span
          class="w-1 h-1 rounded-full bg-[var(--fg-subtle)]"
          aria-hidden="true"></span>
        <span>{post.readingTime}</span>
      </div>

      <div
        slot="header-aside"
        class="flex items-center gap-1.5 md:gap-2 opacity-90 md:opacity-75 hover:opacity-100 transition-opacity duration-300"
      >
        {
          /* Three marks from one seed, checked against each other so no two are
            the same field, ramp and grid. Together they take the space the
            single mark used to. */
        }
        {
          marks.map((seed) => (
            <PostFingerprint
              seed={seed}
              size={56}
              class="size-[34px] sm:size-[44px] md:size-[56px]"
            />
          ))
        }
      </div>

      <slot />
    </ArticleShell>
  </article>
</BaseLayout>
